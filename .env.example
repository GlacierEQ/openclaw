# Generate strong random values locally; never commit real values.
OPENCLAW_API_TOKEN=replace-me
OPENCLAW_MCP_TOKEN=replace-me
OPENCLAW_AUDIT_SECRET=replace-me
OPENCLAW_PROMOTION_SECRET=replace-me
OPENCLAW_LOCAL_GUI=0
OPENCLAW_BROWSER_CDP_URL=
OPENCLAW_WATCH_PATH=.

# Free-agent / model fabric
OLLAMA_HOST=http://127.0.0.1:11434
OPENCLAW_MAX_PARALLEL_AGENTS=8
OPENCLAW_MODEL_FABRIC=.openclaw/model-fabric.json

# Kilo Gateway. Optional for anonymous-capable free routes; recommended when available.
KILO_API_KEY=

# MiMo OpenAI-compatible API
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Optional free/freemium providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free

# Mesh networking (src/mesh_runtime.py). Mesh transport stays disabled unless a
# shared key is set; nodes without the same key cannot join the mesh.
OPENCLAW_MESH_KEY=

# Mobile compute node (src/mobile_node.py). All optional; capabilities are
# reported only when observed or explicitly configured here.
# NPU chip: ane, hexagon, apu, samsung_npu, tensor, or unknown.
OPENCLAW_MOBILE_NPU=unknown
# Comma-separated model ids the node can serve, e.g. qwen2.5:3b,llama3.2:1b
OPENCLAW_MOBILE_MODELS=
# Peak NPU throughput in TOPS (float, e.g. 38).
OPENCLAW_MOBILE_NPU_TOPS=
# Battery level 0-100 (float); unset means unknown.
OPENCLAW_MOBILE_BATTERY_PERCENT=
# 1/true/yes/on when charging; unset means unknown.
OPENCLAW_MOBILE_CHARGING=
# normal, warm, hot, critical, or unknown.
OPENCLAW_MOBILE_THERMAL_STATE=unknown
# Measured on-device inference throughput in tokens/sec (float).
OPENCLAW_MOBILE_INFERENCE_TPS=
# Local Ollama endpoint for the inference handler; unset disables it.
# e.g. http://127.0.0.1:11434
OPENCLAW_MOBILE_OLLAMA_URL=
# Default model for the inference handler when a task names none.
OPENCLAW_MOBILE_DEFAULT_MODEL=
